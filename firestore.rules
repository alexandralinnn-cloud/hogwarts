// Security rules for the Hogwarts database (Cloud Firestore).
// Paste this into Firebase console → Firestore Database → Rules, then press "Publish".
// The UID below is the owner's account (Authentication → Users).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == 'hDqKKGELFzZuMvSwlTlYio4q56i1';
    }

    // Tasks: everyone can read the ones that are not private; only the owner can change them.
    match /tasks/{taskId} {
      allow read: if isOwner() || resource.data.private == false;
      allow write: if isOwner();
    }

    // Points, streak and lit days.
    match /public/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // "Recent" list (private tasks are written without their name).
    match /log/{entryId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Owner-only settings such as Dean's number.
    match /owner/{docId} {
      allow read, write: if isOwner();
    }
  }
}
